# RES POS server settings — copy this file to ".env" and fill in the values.
# ".env" holds secrets: it is never committed to git.

# The database (PostgreSQL). On the VPS: the res_app user and the res_pos database.
DATABASE_URL="postgresql://res_app:PASSWORD@localhost:5432/res_pos"

# "production" on the server: RES then refuses to start without JWT_SECRET.
NODE_ENV=production

# The secret that signs every login. Long and random, different on every server.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everybody out (POS terminals keep their PIN pad).
JWT_SECRET=

# How long a login stays valid without being used (renewed daily while used).
JWT_EXPIRES=7d

# Where RES listens. On the VPS behind IIS: 127.0.0.1 (only IIS can reach it).
HOST=127.0.0.1
PORT=3000
